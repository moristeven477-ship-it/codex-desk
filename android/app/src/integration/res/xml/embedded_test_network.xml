<!-- Integration APK only. Generated test CA never enters debug/release APKs. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/embedded_test_ca" />
        </trust-anchors>
    </base-config>
</network-security-config>
